    {
      "name": "ProtocolStats",
      "docs": [
        "Protocol-wide aggregate statistics, stored at PDA `[b\"stats\"]`.",
        "",
        "Only SOL-denominated values are aggregated. Token amounts and swap fees are",
        "deliberately omitted because different mints and decimals cannot be added",
        "into a meaningful or trustworthy global value without an oracle."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "successful_operations",
            "type": "u64"
          },
          {
            "name": "successful_closes",
            "type": "u64"
          },
          {
            "name": "successful_burns",
            "type": "u64"
          },
          {
            "name": "successful_swaps",
            "type": "u64"
          },
          {
            "name": "total_rent_recovered_lamports",
            "docs": [
              "Lamports returned by successfully closed token accounts."
            ],
            "type": "u64"
          },
          {
            "name": "total_close_fees_lamports",
            "docs": [
              "Lamport-denominated close fees paid into the protocol vault."
            ],
            "type": "u64"
          },
          {
            "name": "last_updated_slot",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "SerializedAccountMeta",
      "docs": [
        "Serialized account meta, mirroring `solana_sdk::instruction::AccountMeta`",
        "but borsh-encodable so it can travel inside instruction data."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "pubkey",
            "type": "pubkey"
          },
          {
            "name": "is_signer",
            "type": "bool"
          },
          {
            "name": "is_writable",
            "type": "bool"
          }
        ]
      }
    },
    {
      "name": "SerializedInstruction",
      "docs": [
        "A raw instruction (as returned by Jupiter's Swap V2 /build) that the",
        "program will re-invoke as a CPI."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "program_id",
            "type": "pubkey"
          },
          {
            "name": "accounts",
            "type": {
              "vec": {
                "defined": {
                  "name": "SerializedAccountMeta"
                }
              }
            }
          },
          {
            "name": "data",
            "type": "bytes"
          }
        ]
      }
    },
    {
      "name": "SwapArgs",
      "docs": [
        "User-signed swap authorization. The user's signature on these fields IS the",
        "fee ceiling: even a compromised planner cannot exceed them."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "in_amount",
            "docs": [
              "Authorized source amount (must equal the live source balance)."
            ],
            "type": "u64"
          },
          {
            "name": "minimum_output",
            "docs": [
              "Minimum output the user accepts (post-fee), in output token units."
            ],
            "type": "u64"
          },
          {
            "name": "platform_fee_bps",
            "docs": [
              "Platform fee the user authorizes, in bps."
            ],
            "type": "u16"
          },
          {
            "name": "user_max_fee_bps",
            "docs": [
              "User's own ceiling on the fee, in bps (must be <= config.swap_max_fee_bps too)."
            ],
            "type": "u16"
          },
          {
            "name": "user_max_fee_amount",
            "docs": [
              "Absolute fee cap in input token units: ceil(in_amount * bps / 10000) must be <= this."
            ],
            "type": "u64"
          },
          {
            "name": "setup_instructions",
            "docs": [
              "Jupiter /build instructions to forward as CPIs (setup, swap, cleanup)."
            ],
            "type": {
              "vec": {
                "defined": {
                  "name": "SerializedInstruction"
                }
              }
            }
          },
          {
            "name": "swap_instruction",
            "type": {
              "defined": {
                "name": "SerializedInstruction"
              }
            }
          },
          {
            "name": "cleanup_instruction",
            "type": {
              "option": {
                "defined": {
                  "name": "SerializedInstruction"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "SweepEvent",
      "docs": [
