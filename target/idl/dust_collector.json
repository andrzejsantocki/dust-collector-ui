  "types": [
    {
      "name": "CollectionEvent",
      "docs": [
        "Emitted by every successful collector action so off-chain services can",
        "reconcile execution vs vault balance without parsing log text."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "action",
            "docs": [
              "One of `ACTION_CLOSE_EMPTY`, `ACTION_BURN_AND_CLOSE`, `ACTION_SWAP_AND_CLOSE`."
            ],
            "type": "u8"
          },
          {
            "name": "token_amount",
            "docs": [
              "Tokens removed from the account (burned or swapped). 0 for close_empty."
            ],
            "type": "u64"
          },
          {
            "name": "rent_recovered",
            "docs": [
              "Lamports recovered from closing the ATA."
            ],
            "type": "u64"
          },
          {
            "name": "protocol_fee",
            "docs": [
              "Lamports paid to the protocol vault."
            ],
            "type": "u64"
          },
          {
            "name": "swap_input",
            "docs": [
              "For swap_and_close: input token amount. 0 otherwise."
            ],
            "type": "u64"
          },
          {
            "name": "swap_output",
            "docs": [
              "For swap_and_close: output token amount. 0 otherwise."
            ],
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "Config",
      "docs": [
        "Protocol-wide configuration, stored at PDA `[\"config\"]`.",
        "",
        "Fee settings are admin-controlled and intentionally conservative:",
        "every on-chain fee is bounded by BOTH the protocol maximum and the",
        "per-transaction maximum the user signs for."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "docs": [
              "Admin who can update the config."
            ],
            "type": "pubkey"
          },
          {
            "name": "protocol_vault",
            "docs": [
              "Vault that receives protocol fees."
            ],
            "type": "pubkey"
          },
          {
            "name": "close_fee_bps",
            "docs": [
              "Fee on rent recovery, in bps (10_000 == 100%)."
            ],
            "type": "u16"
          },
          {
            "name": "close_min_fee_lamports",
            "docs": [
              "Floor for the close fee, in lamports."
            ],
            "type": "u64"
          },
          {
            "name": "close_max_fee_lamports",
            "docs": [
              "Ceiling for the close fee, in lamports."
            ],
            "type": "u64"
          },
          {
            "name": "swap_fee_bps",
            "docs": [
              "Fee on swap value, in bps (10_000 == 100%)."
            ],
            "type": "u16"
          },
          {
            "name": "swap_max_fee_bps",
            "docs": [
              "Absolute ceiling for the swap platform fee, in bps."
            ],
            "type": "u16"
          },
          {
            "name": "jupiter_program",
            "docs": [
              "Jupiter program the protocol will CPI into."
            ],
            "type": "pubkey"
          },
          {
            "name": "paused",
            "docs": [
              "When true, all collector operations fail."
            ],
            "type": "bool"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump."
            ],
            "type": "u8"
          }
        ]
      }
    },
